      "bounds_lnglat",
      "authority",
      "evidence",
      "units",
      "legend",
      "z",
      "style_by"
    ],
    "legend_min_stops_or_categories": 2,
    "bounds_lnglat": "[west, south, east, north] in EPSG:4326; true to 0.1 m vs data"
  },
  "raster": {
    "encoding": "uint16 greyscale PNG",
    "nodata": 65535,
    "row_order_png": "north_to_south (PNG row 0 = north edge)",
    "col_order": "west_to_east",
    "npz_axes": "row = north ascending (south at index 0), col = east ascending",
    "png_to_npz_row": "i = nrows - 1 - png_row",
    "decode": "if pixel == 65535: nodata; else value = value_min + (pixel / 65534) * (value_max - value_min)",
    "sidecar_required": [
      "ncols",
      "nrows",
      "value_min",
      "value_max",
      "nodata",
      "bounds_lnglat",
      "decode",
      "raster"
    ],
    "worked_example": {
      "layer": "twi",
      "sidecar": "analysis/grids/twi.json",
      "png": "analysis/grids/twi.png",
      "png_row": 124,
      "png_col": 164,
      "pixel": 8497,
      "decoded_value": 2.0204662302073575,
      "npz_row": 133,
      "npz_value": 2.020550012588501,
      "max_abs_diff": 0.001
    }
  },
  "instances": {
    "file": "trees-instances.json",
    "required_top": [
      "archetypes",
      "instances",
      "instance_count",
      "archetype_count"
    ],
    "worked_example": {
      "tree_id": 0,
