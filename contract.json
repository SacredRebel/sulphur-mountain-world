{
  "schema": 1,
  "pack_version": "1.0.0",
  "generator": "scripts/check-contract.py",
  "what": "Minimum a consumer can rely on without reading pack source.",
  "semver": {
    "patch": "data corrections that keep field names and meanings",
    "minor": "new layers or new optional fields",
    "major": "any published field or layer id removed or renamed"
  },
  "frame": {
    "file": "pack.json",
    "path": "frame",
    "required_keys": [
      "origin_lng",
      "origin_lat",
      "metres_per_deg_lng",
      "metres_per_deg_lat",
      "axes"
    ],
    "axes": "x east, y north, metres (equirectangular at origin_lat)",
    "formulas": {
      "lng": "origin_lng + east_m / metres_per_deg_lng",
      "lat": "origin_lat + north_m / metres_per_deg_lat",
      "east_m": "(lng - origin_lng) * metres_per_deg_lng",
      "north_m": "(lat - origin_lat) * metres_per_deg_lat"
    },
    "worked_example": {
      "east_m": 260.82,
      "north_m": 267.76,
      "lng": -119.15664291526875,
      "lat": 34.43285107044863
    }
  },
  "manifest": {
    "file": "pack-layers.json",
    "required_fields_all": [
      "id",
      "kind",
      "path",
      "bounds_lnglat",
      "authority",
      "evidence",
      "units",
      "legend",
      "z"
    ],
    "required_fields_image": [
      "id",
      "kind",
      "path",
      "bounds_lnglat",
      "authority",
      "evidence",
      "units",
